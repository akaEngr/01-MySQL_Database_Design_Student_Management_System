
-- STUDENT MANAGEMENT SYSTEM


-- DATABASE


CREATE DATABASE IF NOT EXISTS Student_Management_System;

USE Student_Management_System;

SHOW DATABASES;


-- REQUIREMENTS


-- 1. Departments
--    Each department has a unique ID and name.
--    Store department description.
--    One department can have multiple students and courses.

-- 2. Courses
--    Each course has a unique ID and course code.
--    Store course name, duration and fees.
--    Each course belongs to one department.

-- 3. Students
--    Each student has a unique ID.
--    Store name, age, address, email and phone.
--    Email and phone must be unique.
--    Each student belongs to one department.

-- 4. Enrollments
--    A student can enroll in multiple courses.
--    A course can have multiple students.
--    A student cannot enroll in the same course twice.

-- 5. Examination Sessions
--    Store examination year, month, start date and end date.
--    Each examination session has a unique ID.

-- 6. Exams
--    Each exam belongs to one examination session.
--    Each exam belongs to one course.
--    Store exam name, date and total marks.

-- 7. Student Exams
--    A student can participate in multiple exams.
--    An exam can have multiple students.
--    Store marks obtained and result status.
--    A student cannot have duplicate records for the same exam.

-- 8. Classes
--    Each class belongs to one course.
--    A course can have multiple classes.
--    Store class start date and end date.

-- 9. Attendance
--    Store student attendance for each class.
--    Attendance status can be present, absent or late.
--    A student can have only one attendance record per class.


-- TABLE CREATION



-- 1. Departments

CREATE TABLE departments (
    id INT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(100) NOT NULL UNIQUE,
    description TEXT DEFAULT NULL
);


-- 2. Courses

CREATE TABLE courses (
    id INT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(100) NOT NULL,
    courseID VARCHAR(50) NOT NULL UNIQUE,
    duration INT NOT NULL,
    fees DECIMAL(10,2) NOT NULL,
    department_id INT NOT NULL,

    FOREIGN KEY (department_id)
    REFERENCES departments(id),

    CHECK (duration > 0),
    CHECK (fees >= 0)
);


-- 3. Students

CREATE TABLE students (
    id INT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(100) NOT NULL,
    age INT NOT NULL,
    address TEXT NOT NULL,
    email VARCHAR(100) NOT NULL UNIQUE,
    phone VARCHAR(15) NOT NULL UNIQUE,
    department_id INT NOT NULL,

    FOREIGN KEY (department_id)
    REFERENCES departments(id),

    CHECK (age > 0)
);


-- 4. Enrollments

CREATE TABLE enroll (
    id INT PRIMARY KEY AUTO_INCREMENT,
    student_id INT NOT NULL,
    course_id INT NOT NULL,

    FOREIGN KEY (student_id)
    REFERENCES students(id),

    FOREIGN KEY (course_id)
    REFERENCES courses(id),

    UNIQUE (student_id, course_id)
);


-- 5. Examination Sessions

CREATE TABLE examination_sessions (
    id INT PRIMARY KEY AUTO_INCREMENT,
    session_year YEAR NOT NULL,
    session_month TINYINT NOT NULL,
    start_date DATE NOT NULL,
    end_date DATE NOT NULL,

    CHECK (session_month BETWEEN 1 AND 12),
    CHECK (end_date >= start_date)
);


-- 6. Exams

CREATE TABLE exams (
    id INT PRIMARY KEY AUTO_INCREMENT,
    exam_name VARCHAR(100) NOT NULL,
    exam_date DATE NOT NULL,
    total_marks DECIMAL(6,2) NOT NULL,
    session_id INT NOT NULL,
    course_id INT NOT NULL,

    FOREIGN KEY (session_id)
    REFERENCES examination_sessions(id),

    FOREIGN KEY (course_id)
    REFERENCES courses(id),

    CHECK (total_marks > 0)
);


-- 7. Student Exams

CREATE TABLE student_exams (
    id INT PRIMARY KEY AUTO_INCREMENT,
    student_id INT NOT NULL,
    exam_id INT NOT NULL,
    marks_obtained DECIMAL(6,2) DEFAULT NULL,
    result_status VARCHAR(20) NOT NULL DEFAULT 'pending',

    FOREIGN KEY (student_id)
    REFERENCES students(id),

    FOREIGN KEY (exam_id)
    REFERENCES exams(id),

    UNIQUE (student_id, exam_id),

    CHECK (
        marks_obtained IS NULL
        OR marks_obtained >= 0
    )
);


-- 8. Classes

CREATE TABLE classes (
    id INT PRIMARY KEY AUTO_INCREMENT,
    start_date DATE NOT NULL,
    end_date DATE NOT NULL,
    course_id INT NOT NULL,

    FOREIGN KEY (course_id)
    REFERENCES courses(id),

    CHECK (end_date > start_date)
);


-- 9. Attendance

CREATE TABLE attendance (
    id INT PRIMARY KEY AUTO_INCREMENT,
    class_id INT NOT NULL,
    student_id INT NOT NULL,
    status ENUM('present', 'absent', 'late')
    NOT NULL DEFAULT 'absent',

    FOREIGN KEY (class_id)
    REFERENCES classes(id),

    FOREIGN KEY (student_id)
    REFERENCES students(id),

    UNIQUE (class_id, student_id)
);


