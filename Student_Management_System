-- BASIC QUERIES



-- Display student names

SELECT name
FROM students;


-- Find students whose age is 21

SELECT *
FROM students
WHERE age = 21;


-- Find students whose names start with A

SELECT *
FROM students
WHERE name LIKE 'A%';


-- Find students whose names end with u

SELECT *
FROM students
WHERE name LIKE '%u';


-- Calculate total age of all students

SELECT SUM(age) AS total_age
FROM students;


-- Count total students

SELECT COUNT(*) AS total_students
FROM students;


-- Find average student age

SELECT AVG(age) AS average_age
FROM students;


-- JOIN QUERIES



-- Display students with their department names

SELECT
    s.id,
    s.name AS student_name,
    d.name AS department_name

FROM students AS s

INNER JOIN departments AS d
ON s.department_id = d.id;


-- Display courses with their department names

SELECT
    c.id,
    c.name AS course_name,
    c.courseID,
    d.name AS department_name

FROM courses AS c

INNER JOIN departments AS d
ON c.department_id = d.id;


-- Display students with their enrolled courses

SELECT
    s.name AS student_name,
    c.name AS course_name

FROM enroll AS e

INNER JOIN students AS s
ON e.student_id = s.id

INNER JOIN courses AS c
ON e.course_id = c.id;


-- Display exams with their course names and session details

SELECT
    e.exam_name,
    e.exam_date,
    e.total_marks,
    c.name AS course_name,
    es.session_year,
    es.session_month

FROM exams AS e

INNER JOIN courses AS c
ON e.course_id = c.id

INNER JOIN examination_sessions AS es
ON e.session_id = es.id;


-- Display students with their exam marks

SELECT
    s.name AS student_name,
    e.exam_name,
    se.marks_obtained,
    se.result_status

FROM student_exams AS se

INNER JOIN students AS s
ON se.student_id = s.id

INNER JOIN exams AS e
ON se.exam_id = e.id;


-- Display classes with their course names

SELECT
    cl.id AS class_id,
    c.name AS course_name,
    cl.start_date,
    cl.end_date

FROM classes AS cl

INNER JOIN courses AS c
ON cl.course_id = c.id;


-- Display attendance with student and course details

SELECT
    s.name AS student_name,
    c.name AS course_name,
    a.class_id,
    a.status

FROM attendance AS a

INNER JOIN students AS s
ON a.student_id = s.id

INNER JOIN classes AS cl
ON a.class_id = cl.id

INNER JOIN courses AS c
ON cl.course_id = c.id;


-- GROUP BY QUERIES



-- Count students in each department

SELECT
    d.name AS department_name,
    COUNT(s.id) AS total_students

FROM departments AS d

LEFT JOIN students AS s
ON d.id = s.department_id

GROUP BY d.id, d.name;


-- Count students enrolled in each course

SELECT
    c.name AS course_name,
    COUNT(e.student_id) AS total_students

FROM courses AS c

LEFT JOIN enroll AS e
ON c.id = e.course_id

GROUP BY c.id, c.name;


-- Calculate average marks in each exam

SELECT
    e.exam_name,
    AVG(se.marks_obtained) AS average_marks

FROM exams AS e

LEFT JOIN student_exams AS se
ON e.id = se.exam_id

GROUP BY e.id, e.exam_name;


-- Count attendance status in each class

SELECT
    class_id,
    status,
    COUNT(*) AS total_students

FROM attendance

GROUP BY class_id, status;


